{
  "name": "tailq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts && prettier --write lib/database.types.ts",
    "test:coverage": "vitest run --coverage",
    "db:test": "supabase test db",
    "eval": "node --env-file=.env.local eval/grading.mjs",
    "seed:questions": "node --env-file=.env.local scripts/seed-questions.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "geist": "^1.8.2",
    "next": "16.4.3",
    "pretendard": "^1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
