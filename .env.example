# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 커밋하지 않는다.
# 로컬 Supabase 값은 `npm run db:start`가 끝날 때 출력된다(`npx supabase status`로 다시 볼 수 있다).

# Claude API (서버 전용). 테스트·CI는 MSW와 AI_MOCK으로 대신해 이 키를 쓰지 않는다.
ANTHROPIC_API_KEY=
# 1이면 Claude를 부르지 않고 픽스처로 응답한다
AI_MOCK=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 브라우저 코드에서 쓰지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# 소셜 로그인 (로컬 Supabase가 supabase/config.toml에서 읽는다. supabase/.env에 두거나 셸 환경변수로 넣는다)
# GitHub OAuth 앱의 Client ID·Secret
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
# Google Cloud OAuth 클라이언트(웹 애플리케이션)의 ID·Secret
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# 카카오 디벨로퍼스 앱의 REST API 키·Client Secret
SUPABASE_AUTH_KAKAO_CLIENT_ID=
SUPABASE_AUTH_KAKAO_SECRET=

# 웹 푸시 (`npx web-push generate-vapid-keys`로 만든다)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron이 보내는 인증 값
CRON_SECRET=
# 체험 IP를 저장하기 전에 HMAC으로 가리는 키
TRIAL_IP_HMAC_SECRET=

# AI 비용 (docs/09 5장)
AI_MONTHLY_BUDGET_USD=20
KRW_PER_USD=1400

# 비공개 질문 저장소를 체크아웃한 경로 (질문 시드 스크립트용, docs/08 5장)
CONTENT_DIR=
